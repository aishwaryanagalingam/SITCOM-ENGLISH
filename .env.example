# Option A: Anthropic (Claude)
ANTHROPIC_API_KEY=your-key-here

# Option B: any OpenAI-compatible provider (many have a free tier). Uncomment all four.
# LLM_PROVIDER=openai
# LLM_API_KEY=your-key-here
# LLM_BASE_URL=https://<provider-base-url>/chat/completions
# MODEL=<model-name-from-provider-docs>

# Optional
PORT=3000
# Only allow requests from your own site (leave empty while testing)
ALLOWED_ORIGIN=
# Max chat requests per visitor per window
RATE_LIMIT_MAX=40
RATE_LIMIT_WINDOW_MIN=10
